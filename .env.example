# Copy to .env.local for local dev. Never commit real keys.
# In Cloud Run these come from Secret Manager (see docs/DEPLOY.md, T-401).

# Google AI Studio key, used for Gemma 4 (planner) and Gemini image editing (staging).
GEMINI_API_KEY=

# Gemma 4 model ID; confirm what the key can access (T-101).
GEMMA_MODEL=gemma-4-26b-a4b-it

# World Labs Marble API key (T-404, optional layer).
WORLDLABS_API_KEY=
