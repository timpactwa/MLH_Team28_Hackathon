# Copy to .env.local for local dev. Never commit real keys.
# On Vercel, set them under Project Settings > Environment Variables (see docs/DEPLOY.md, T-401).
# A Google AI Studio key works without billing; its free tier is rate-limited.

# Google AI Studio key, used for Gemma 4 (planner) and Gemini image editing (staging).
GEMINI_API_KEY=

# Gemma 4 model ID; confirm what the key can access (T-101).
GEMMA_MODEL=gemma-4-26b-a4b-it

# Gemini image model for the staged concept (T-403). Image output may need billing on the key.
STAGING_MODEL=gemini-2.5-flash-image

# World Labs Marble API key (T-404, optional layer).
WORLDLABS_API_KEY=
